# ============================================================
# .env.example — Enterprise AI Gateway
#
# HOW TO USE:
#   cp .env.example .env
#   Fill in your real values in .env
#   NEVER commit .env to git — it is in .gitignore
# ============================================================

# --- App ---
APP_NAME="Enterprise AI Gateway"
ENVIRONMENT=development         # development | staging | production
SECRET_KEY=change-me-to-a-long-random-string-in-production
DEBUG=true

# --- Database (PostgreSQL) ---
# Local Docker: use the service name "postgres" as the host
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=enterprise_ai
POSTGRES_USER=ai_user
POSTGRES_PASSWORD=change-me-postgres-password
DATABASE_URL=postgresql://ai_user:change-me-postgres-password@postgres:5432/enterprise_ai

# --- Cache (Redis) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:change-me-redis-password@redis:6379/0

# --- JWT Authentication ---
JWT_SECRET_KEY=change-me-jwt-secret-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- LiteLLM Proxy ---
# This is the internal URL of the LiteLLM proxy service (Docker service name)
LITELLM_PROXY_URL=http://litellm:4000
LITELLM_MASTER_KEY=change-me-litellm-master-key

# --- LLM Provider API Keys ---
# Add only the providers you plan to use. LiteLLM will only load keys that exist.
OPENAI_API_KEY=sk-proj-...your-openai-key-here...
ANTHROPIC_API_KEY=sk-ant-...your-anthropic-key-here...
GEMINI_API_KEY=AIza...
MISTRAL_API_KEY=...
COHERE_API_KEY=...

# --- CORS (comma-separated list of allowed origins) ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Email (optional — for user invites and notifications) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@yourcompany.com
SMTP_PASSWORD=change-me-smtp-password
