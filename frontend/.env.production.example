# ============================================================
# frontend/.env.production.example
#
# HOW TO USE:
#   cp frontend/.env.production.example frontend/.env.production
#   Set VITE_API_URL to your real backend URL before building.
#
# ARCHITECT'S NOTE:
#   Vite reads this file at BUILD TIME (not runtime).
#   The value is baked into the compiled JavaScript bundle.
#   This means you must rebuild the frontend image whenever
#   the backend URL changes.
#
#   For an internal deployment named ai.acme.internal:
#     VITE_API_URL=https://ai.acme.internal/api
#
#   For an external deployment at ai.acme.com:
#     VITE_API_URL=https://ai.acme.com/api
#
#   In development, Vite's proxy (vite.config.ts) handles /api
#   forwarding automatically — no VITE_API_URL needed locally.
# ============================================================

VITE_API_URL=https://ai.acme.com/api
